{
  "ID": "openbao",
  "Name": "openbao",
  "Port": 8200,
  "Tags": [
    "traefik.enable=true",
    "traefik.http.routers.openbao.entrypoints=web,websecure",
    "traefik.http.routers.openbao.rule=Host(`openbao.ops.home.arpa`)",
    "traefik.http.routers.openbao.tls=true",
    "traefik.http.services.openbao.loadbalancer.server.port=8200",
    "traefik.http.services.openbao.loadbalancer.server.scheme=https",
    "traefik.http.services.openbao.loadbalancer.serversTransport=self-signed@file"
  ],
  "Check": {
    "HTTP": "https://127.0.0.1:8200/v1/sys/health",
    "TLSSkipVerify": true,
    "Interval": "10s",
    "Timeout": "5s"
  }
}
